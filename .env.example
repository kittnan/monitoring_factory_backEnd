# Monitoring Factory backend settings.
# Copy this file to .env and fill in the values. .env is not committed to git.

# --- Server ---
PORT=4014

# --- MongoDB ---
MONGODB_URI=mongodb://user:password@host:27017
MONGODB_DB=monitoring-factory

# --- Oracle (not used by the code yet) ---
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=host:1521/service

# --- FTP (machine CSV logs) ---
FTP_HOST=192.168.0.10
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=/MMC
FTP_TIMEOUT_MS=10000
# Wait until a file on the FTP has kept the same size for N seconds before
# downloading it (the logger may still be writing it). 0 = no wait
FTP_MIN_AGE_SEC=60

# Local folder where downloaded CSV files are stored before import
# Windows: D:\MonitoringFactoryCSV\ftpData
# Docker (Linux): the container path of the mounted volume, e.g.
#   CSV_DIR=/file_serve/MonitoringFactoryCSV/ftpData
CSV_DIR=D:\MonitoringFactoryCSV\ftpData

# --- Job timing (kv.method.js) ---
# Download new CSV files from the FTP every N seconds
JOB_FTP_EVERY_SEC=30
# Import downloaded CSV files into MongoDB every N seconds (per page)
JOB_IMPORT_EVERY_SEC=5
# Move readings older than 24h into kv*_records every N seconds (per page)
JOB_RECONSTRUCT_EVERY_SEC=60
# Max timestamps moved per run; raise to catch up a backlog faster
JOB_RECONSTRUCT_MAX_PER_RUN=500

# --- Auto backup ---
# Daily Excel files: <BACKUP_DIR>\<kv>\<YYYY-MM-DD>.xlsx
# Docker (Linux), e.g.
#   BACKUP_DIR=/file_serve/MonitoringFactoryCSV/MonitoringFactoryBackup
BACKUP_DIR=D:\MonitoringFactoryBackup
# Run time each day (server local time, HH:MM)
BACKUP_TIME=00:10
# Only back up days at least this old (records arrive ~24h late)
BACKUP_COMPLETE_AFTER_DAYS=2
